{
  "name": "@heyrafiki/contract",
  "version": "0.1.0-beta.1",
  "description": "The versioned REST contract for the Heyrafiki API.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "openapi.yaml",
    "README.md",
    "FINANCIAL_CONTROLS.md",
    "ASSURANCE_GRAPH.md",
    "BENCHMARK.md",
    "benchmark/manifest.json",
    "assurance/assurance-graph.schema.json",
    "assurance/assurance-graph.json",
    "assurance/claim-valuation-timeline.schema.json",
    "fixtures/financial-controls.json",
    "fixtures/claim-valuation-timeline.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyrafiki/contract.git"
  },
  "homepage": "https://docs.heyrafiki.space",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "test": "npm run lint && node scripts/check-contract.mjs && npm run test:financial-controls && npm run test:assurance && npm run benchmark",
    "test:financial-controls": "node scripts/check-financial-controls.mjs && node scripts/check-claim-valuation-timeline.mjs",
    "test:assurance": "node scripts/check-assurance-graph.mjs",
    "benchmark": "node scripts/run-assurance-benchmark.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@redocly/cli": "2.44.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
