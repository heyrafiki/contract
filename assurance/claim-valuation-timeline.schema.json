{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.heyrafiki.space/insurance/claim-valuation-timeline/1.0.0",
  "title": "Heyrafiki Claim valuation timeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "currency",
    "minor_unit",
    "policy",
    "service_period",
    "valuation_at",
    "events",
    "valuation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "claim_id": { "type": "string", "pattern": "^clm_[A-Za-z0-9_-]+$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "minor_unit": { "type": "integer", "minimum": 0, "maximum": 6 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "version"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "service_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "ends_at"],
      "properties": {
        "starts_at": { "type": "string", "format": "date-time" },
        "ends_at": { "type": "string", "format": "date-time" }
      }
    },
    "valuation_at": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_event_sequence",
        "claim_status",
        "financial_status",
        "billed",
        "payer_liability",
        "patient_responsibility",
        "adjustment",
        "remitted",
        "settled",
        "outstanding"
      ],
      "properties": {
        "source_event_sequence": { "type": "integer", "minimum": 1 },
        "claim_status": { "type": "string" },
        "financial_status": {
          "enum": ["unadjudicated", "unremitted", "remitted", "partially_settled", "settled", "reversed"]
        },
        "billed": { "$ref": "#/$defs/amount" },
        "payer_liability": { "$ref": "#/$defs/amount" },
        "patient_responsibility": { "$ref": "#/$defs/amount" },
        "adjustment": { "$ref": "#/$defs/amount" },
        "remitted": { "$ref": "#/$defs/amount" },
        "settled": { "$ref": "#/$defs/amount" },
        "outstanding": { "$ref": "#/$defs/amount" }
      }
    }
  },
  "$defs": {
    "amount": { "type": "integer", "minimum": 0 },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_id",
        "event_type",
        "effective_at",
        "recorded_at",
        "source_authority",
        "evidence_references"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "event_id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" },
        "event_type": {
          "enum": [
            "care_delivered",
            "claim_submitted",
            "information_requested",
            "evidence_received",
            "claim_adjudicated",
            "remittance_received",
            "settlement_observed",
            "settlement_reversed"
          ]
        },
        "effective_at": { "type": "string", "format": "date-time" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "source_authority": {
          "enum": ["provider", "payer", "heyrafiki_finance", "payment_rail"]
        },
        "previous_status": { "type": ["string", "null"] },
        "next_status": { "type": ["string", "null"] },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]{2,80}$" },
          "uniqueItems": true
        },
        "amounts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/amount" }
        },
        "evidence_references": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
